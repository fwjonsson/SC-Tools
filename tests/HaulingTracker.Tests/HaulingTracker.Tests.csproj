<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests of the core, the web view and the server's database. They run on any machine: dotnet test (GitHub runs them on every change). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>HaulingTracker.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HaulingTracker.Core/HaulingTracker.Core.csproj" />
    <ProjectReference Include="../../src/HaulingTracker.Web/HaulingTracker.Web.csproj" />
    <ProjectReference Include="../../src/HaulingTracker.Server/HaulingTracker.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
