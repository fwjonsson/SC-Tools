<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tests of the core, the web view and the server's database. They run on any machine: dotnet test (GitHub runs them on every change). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SCTools.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- starts the server in the tests (its pages, the logins and the uploads, over HTTP in memory) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SCTools.Core/SCTools.Core.csproj" />
    <ProjectReference Include="../../src/SCTools.Web/SCTools.Web.csproj" />
    <ProjectReference Include="../../src/SCTools.Server/SCTools.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
