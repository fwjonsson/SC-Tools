<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The web app (plan: claude/webapp-plan.md in the project): the trackers upload their Game.log lines here, the server works out the sessions with the core
       (the same logic as the program), and everybody watches the live page. The data is in a SQLite database (EF Core, Data/); the admin and the players log in
       with ASP.NET Core Identity (Accounts/), and the pages are MVC (Controllers/, Models/, Views/). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SCTools.Server</RootNamespace>
    <!-- App_Data is the server's own data when it runs (the database, the logs, the data file to import): not part of the program, never copied with it -->
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data/**</DefaultItemExcludes>
    <!-- the admin password on your own computer: Manage User Secrets in Visual Studio (never in appsettings.json, which is in the repository) -->
    <UserSecretsId>f41f5e2c-1809-4eb6-8338-13d681bb5011</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <!-- the logins: the admin with a password, the players with their tracker -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <!-- the tools that make the migrations (dotnet ef); not part of the server itself -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SCTools.Core/SCTools.Core.csproj" />
    <ProjectReference Include="../SCTools.Web/SCTools.Web.csproj" />
  </ItemGroup>

</Project>
