@model HomeModel
@{
    ViewData["Title"] = "Home";
}
@* the landing page (Frank, 30 Oct 2026, his pick of the mock-ups): the title and the slogan centred over a screenshot of the crew's ship in space
   (wwwroot/img/landing.jpg), and under them a row of links to the tools this viewer sees (the Tools page says which everybody sees), each with a dot in the
   tool's colour and what it shows now as its hover text; the ones that are not here yet are dim. The orbit rings and the cards went *@
<div class="landing">
  <section class="hero">
    <h1>SC Tools</h1>
    <p>Tools for our Star Citizen crew, fed by the game's own log.</p>
    @if (Model.Cards.Count == 0)
    {
      <p class="nothing">Nothing here yet.</p>
    }
    <div class="enter">
      @foreach (var card in Model.Cards)
      {
        var tool = card.Tool;
        var live = tool.Path != null;
        <a class="tool@(live ? "" : " soon")" href="@(tool.Path ?? "#")" style="--c:@tool.Color" title="@card.State" aria-disabled="@(live ? null : "true")">
          <span class="dot"></span><span class="tool-name">@tool.Name</span>@if (card.OnlyAdmin) { <span class="tool-hidden">Only you see this</span> }
        </a>
      }
    </div>
  </section>
</div>
