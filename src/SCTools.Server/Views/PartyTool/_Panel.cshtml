@model PartyToolPage
@{
    // the panel of the Party button in the top bar (TopBar.PartyButton, fetched when it opens): the parties now, each a table like the Hauling Planner's
    // old Party table (Frank, 29 Oct 2026: Member, Ship, QT Drive, every member's row in his colour), and a link to the Party page
    Layout = null;
    string Link(string name) => "/party/" + Uri.EscapeDataString(name);
    var playing = Model.Parties.Sum(p => p.Names.Count);
}
<div class="partypanel">
  <p class="head"><span>@(playing == 0 ? "Nobody is playing now." : playing + " playing" + (Model.Parties.Count > 1 ? " in " + Model.Parties.Count + " parties" : ""))</span>
    <a href="/party">Everybody ›</a></p>
  @foreach (var p in Model.Parties)
  {
    <div class="group">
      <b>@p.Title</b>
      <table class="members">
        <thead><tr><th>Member</th><th>Ship</th><th>QT Drive</th></tr></thead>
        <tbody>
        @foreach (var n in p.Names)
        {
          var m = Model.Ships.TryGetValue(n, out var line) ? line : new PartyMemberLine("", "", "#888888", "#ffffff");
          <tr style="background:@m.Color;color:@m.Text"><td><a href="@Link(n)">@n.ToUpperInvariant()</a></td><td>@m.Ship</td><td>@m.Drive</td></tr>
        }
        </tbody>
      </table>
    </div>
  }
  @if (Model.Others.Count > 0)
  {
    <p class="muted small">Not playing: @string.Join(", ", Model.Others.Select(o => o.Name))</p>
  }
</div>
