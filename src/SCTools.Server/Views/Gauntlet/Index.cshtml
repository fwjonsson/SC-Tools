@model GauntletPage
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    string Money(double v) => Math.Round(v).ToString("N0", inv);
    string Dur(double? sec)
    {
        if (sec == null) return "-";
        var t = TimeSpan.FromSeconds(Math.Round(sec.Value));
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes}:{t.Seconds:00}";
    }
    string When(DateTime utc) => utc.ToString("d MMM HH:mm", inv) + " UTC";
    string Hours(double h) => Dur(h * 3600);
    string Tab(string key, string text) =>
        $"<a href=\"/gauntlet/{key}\"{(Model.Tab == key ? " class=\"on\"" : "")}>{text}</a>";
    var whose = Model.InParty ? "your party" : "you";
}
@section subnav {
  @* the tabs as a row under the bar in the tool's colour, like the admin's pages (Frank, 30 Oct 2026); at the right end the team status line (ticker.js), as
     on the other gameplay tools (Frank, 31 Oct 2026) *@
  <nav class="subnav area" style="--tool:@SiteTools.Gauntlet.Color">
  @Html.Raw(Tab("session", "Session"))
  @Html.Raw(Tab("stats", "Stats"))
  @Html.Raw(Tab("history", "History"))
  @Html.Raw(Tab("leaderboard", "Leaderboard"))
  <span class="ticker" data-ticker></span>
  </nav>
  <script src="~/ticker.js" asp-append-version="true" defer></script>
}

@* the tabs say nothing about whose runs they show (Frank, 30 Oct 2026): the Party panel in the top bar says who plays with whom *@

@if (Model.RunCount == 0 && Model.Tab != "leaderboard" && Model.Tab != "session" && !Model.Visitor)
{
  <p class="card">No gauntlet missions seen yet for @(Model.InParty ? "your party" : Model.Player). They are counted from the log your tracker uploads, from the moment the tracker runs (keep it running while you play).</p>
}

@if (Model.Visitor && Model.Tab != "leaderboard")
{
  @await Html.PartialAsync("~/Views/Shared/LogInNote.cshtml", "Your runs and your party's are here once you are logged in; the Leaderboard is everybody's.")
}
else if (Model.Tab == "session")
{
  @* the map with you and your party, as the Companion's and its size (Frank, 31 Oct 2026): the systems as the engine's buttons in its corner, the players
     beside it (map.js), and beside them the Game Session with the Grind Session under it (Frank, 31 Oct 2026: under the map side by side before). Both
     tables are always there, nought while nothing is counted *@
  var none = new SCTools.Gauntlet.GauntletSessionStats(DateTime.MinValue, DateTime.MinValue, new SCTools.Gauntlet.GauntletTotals(0, 0, 0, 0, 0));
  <div class="maptool gauntletmap">
    <div class="mapbox">
      <div id="map" data-src="/gauntlet/map.json"></div>
    </div>
    <div class="mapside players">
      <h2>Players</h2>
      <div id="players"><p class="muted">Loading…</p></div>
    </div>
    <div class="mapside objectives gauntletsessions">
      <h2>Game Session</h2>
      @await Html.PartialAsync("_Totals", Model.Game ?? none)
      @* what a grind session is: under its own table, as wide as it (Frank, 31 Oct 2026) *@
      <h2>Grind Session</h2>
      @if (Model.Grind != null)
      {
        <p class="hint">Running since @When(Model.Grind.Stats.Start).</p>
      }
      else
      {
        <p class="hint">No grind session now.</p>
      }
      @await Html.PartialAsync("_Totals", Model.Grind?.Stats ?? none)
      <p class="hint below">A grind session starts by itself when @whose accept@(Model.InParty ? "s" : "") a scenario and goes on while @whose play@(Model.InParty ? "s" : "") them. After an hour
        without accepting, completing or abandoning one (also when the game crashed or the tracker was off), it ends 5 minutes after the last one. The earlier
        ones are on History.</p>
    </div>
  </div>
  @* no runs yet: said under the map on this tab, so the map, the Players and the Game Session start level at the top (Frank, 31 Oct 2026) *@
  @if (Model.RunCount == 0)
  {
    <p class="card">No gauntlet missions seen yet for @(Model.InParty ? "your party" : Model.Player). They are counted from the log your tracker uploads, from the moment the tracker runs (keep it running while you play).</p>
  }
  <script src="~/systemmap.js" asp-append-version="true" defer></script>
  <script src="~/map.js" asp-append-version="true" defer></script>
}
else if (Model.Tab == "stats")
{
  @* Frank, 30 Oct 2026: the earnings (Lifetime until then) top left, the top 10 top right, the earnings per scenario (Earnings ranking until then) under
     them and the times by scenario last; the first two were on History *@
  var top = Model.Scenarios.First(s => s.Scenario == Model.Selected).Top;
  <div class="pair">
  <div>
  <h2>Earnings</h2>
  <table class="wide">
    <tbody>
      <tr><th>Total earned (aUEC + scrip at your value)</th><td class="right">@Money(Model.Lifetime.TotalAuec) aUEC</td></tr>
      <tr><th>aUEC</th><td class="right">@Money(Model.Lifetime.Auec)</td></tr>
      <tr><th>MG scrip</th><td class="right">@Money(Model.Lifetime.Scrip)</td></tr>
      <tr><th>Completed</th><td class="right">@Model.Lifetime.Completed</td></tr>
      <tr><th>Cancelled (not counted)</th><td class="right">@Model.Lifetime.Cancelled</td></tr>
    </tbody>
  </table>
  </div>
  <div>
  @* the scenario to pick right of the title (Frank, 30 Oct 2026); data-autosave: picking one shows it (autosave.js), the page comes back here *@
  <div class="titled">
  <h2 id="top10">Top 10 fastest</h2>
  <form method="get" action="/gauntlet/stats#top10" class="line" data-autosave>
    <label for="scenario">Scenario</label>
    <select id="scenario" name="scenario">
      @for (var n = 1; n <= GauntletRewards.Scenarios; n++)
      {
        <option value="@n" selected="@(n == Model.Selected)">#@n</option>
      }
    </select>
    <noscript><button type="submit">Show</button></noscript>
  </form>
  </div>
  @if (top.Count == 0)
  {
    <p class="muted">No timed runs of scenario #@Model.Selected yet.</p>
  }
  else
  {
    <table class="wide">
      <thead><tr><th class="n">#</th><th>Time</th>@if (Model.InParty) { <th>Who</th> }<th>When</th></tr></thead>
      <tbody>
      @for (var i = 0; i < top.Count; i++)
      {
        <tr><td class="n">@(i + 1)</td><td class="right">@Dur(top[i].TimingSec)</td>@if (Model.InParty) { <td>@Model.RunBy.GetValueOrDefault(top[i].MissionId, "")</td> }<td>@When(top[i].EndedUtc)</td></tr>
      }
      </tbody>
    </table>
  }
  </div>
  </div>

  <h2>Earnings per scenario</h2>
  <p class="hint">Every scenario with a timed run, ranked by total aUEC per hour at its average time (aUEC plus MG scrip at @Money(Model.ScripValue) aUEC each).
    Scrip/h is the MG scrip alone.</p>
  @if (Model.Ranking.Count == 0)
  {
    <p class="muted">Nothing to rank yet: no timed runs.</p>
  }
  else
  {
    <table class="wide">
      <thead><tr><th class="n">#</th><th>Scenario</th><th>Average</th><th>Scrip/h</th><th>Total aUEC/h (average)</th><th>Total aUEC/h (at fastest)</th><th>Lifetime earned</th></tr></thead>
      <tbody>
      @for (var i = 0; i < Model.Ranking.Count; i++)
      {
        var s = Model.Ranking[i];
        <tr>
          <td class="n">@(i + 1)</td>
          <td>#@s.Scenario</td>
          <td class="right">@Dur(s.Average)</td>
          <td class="right">@((s.ScripPerHourAtAverage ?? 0).ToString("N1", inv))</td>
          <td class="right">@Money(s.TotalPerHourAtAverage ?? 0)</td>
          <td class="right">@Money(s.TotalPerHourAtFastest ?? 0)</td>
          <td class="right">@Money(s.LifetimeTotal)</td>
        </tr>
      }
      </tbody>
    </table>
  }

  <h2>Times by scenario</h2>
  <p class="hint">From accepting to completing. A run over 15 minutes (60 for scenario 8) is not timed; its reward still counts.</p>
  <table class="wide">
    <thead><tr><th>Scenario</th><th>Completed</th><th>Cancelled</th><th>Average</th><th>Fastest</th><th>Slowest</th></tr></thead>
    <tbody>
    @foreach (var s in Model.Scenarios)
    {
      <tr>
        <td>#@s.Scenario</td>
        <td class="right">@s.Completed</td>
        <td class="right">@s.Cancelled</td>
        <td class="right">@Dur(s.Average)</td>
        <td class="right">@Dur(s.Fastest)</td>
        <td class="right">@Dur(s.Slowest)</td>
      </tr>
    }
    </tbody>
  </table>
}
else if (Model.Tab == "history")
{
  @* the earlier grind sessions (on the Session tab until 30 Oct 2026, Frank); the lifetime totals and the ranking went to Stats that day *@
  <h2>Earlier grind sessions</h2>
  @if (Model.PastGrinds.Count == 0)
  {
    <p class="muted">None yet: a grind session is here once it has ended.</p>
  }
  else
  {
    <table class="wide">
      <thead><tr><th>Started</th><th>Length</th><th>Runs</th><th>aUEC/h</th><th>Scrip/h</th><th>Total aUEC/h</th><th>Total earned</th></tr></thead>
      <tbody>
      @foreach (var g in Model.PastGrinds)
      {
        <tr>
          <td>@When(g.Stats.Start)</td>
          <td class="right">@Hours(g.Stats.Hours)</td>
          <td class="right">@g.Stats.Totals.Completed</td>
          <td class="right">@Money(g.Stats.AuecPerHour)</td>
          <td class="right">@g.Stats.ScripPerHour.ToString("N1", inv)</td>
          <td class="right">@Money(g.Stats.TotalPerHour)</td>
          <td class="right">@Money(g.Stats.Totals.TotalAuec)</td>
        </tr>
      }
      </tbody>
    </table>
  }
}
else
{
  @* the title alone over the ranking (Frank, 30 Oct 2026: "All-time leaderboard", no text); the rewards are the Combat Gauntlet scenarios on Edit Mission Info, the scrip value on Scrip *@
  <h2>All-time leaderboard</h2>
  @if (Model.Leaderboard.Count == 0)
  {
    <p class="muted">Nobody has a gauntlet mission yet.</p>
  }
  else
  {
    <div class="scroll">
    <table class="wide">
      <thead><tr><th class="n">#</th><th>Player</th><th>Total earned</th><th>aUEC</th><th>MG scrip</th><th>Total aUEC/h</th><th>Completed</th><th>Completion rate</th>
        <th>Fastest run</th><th>Favourite</th><th>Best per hour</th><th>Last played</th></tr></thead>
      <tbody>
      @for (var i = 0; i < Model.Leaderboard.Count; i++)
      {
        var l = Model.Leaderboard[i];
        var mine = l.Player.Equals(Model.Player, StringComparison.OrdinalIgnoreCase);
        <tr class="@(mine ? "me" : l.Combined ? "combined" : null)">
          <td class="n">@(l.Combined ? "" : (i + 1).ToString(inv))</td>
          <td>@l.Player</td>
          <td class="right">@Money(l.Total)</td>
          <td class="right">@Money(l.Auec)</td>
          <td class="right">@l.Scrip.ToString("N0", inv)</td>
          <td class="right">@(l.TotalPerHour == null ? "-" : Money(l.TotalPerHour.Value))</td>
          <td class="right">@l.Completed</td>
          <td class="right">@(l.CompletionRate == null ? "-" : (l.CompletionRate.Value * 100).ToString("N0", inv) + " %")</td>
          <td>@(l.Fastest == null ? "-" : Dur(l.Fastest.TimingSec) + " (#" + l.Fastest.Scenario + ")")</td>
          <td>@(l.Favourite == null ? "-" : "#" + l.Favourite)</td>
          <td>@(l.BestScenario == null ? "-" : "#" + l.BestScenario + " (" + Money(l.BestScenarioPerHour ?? 0) + "/h)")</td>
          <td>@(l.LastPlayed == null ? "-" : When(l.LastPlayed.Value))</td>
        </tr>
      }
      </tbody>
    </table>
    </div>
  }
}
