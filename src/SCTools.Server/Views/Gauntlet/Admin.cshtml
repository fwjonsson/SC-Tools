@model GauntletAdminPage
@{
    string N(long v) => v.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
}
<h1>Gauntlet</h1>
<p class="muted">What the Gauntlet Tracker counts with, the same for everybody (their pages and the leaderboard). The rewards of the scenarios are in the
  Mission Library, with every other mission: change them on <a href="/admin/missions">Edit Mission Info</a> (click a scenario). What a MG scrip is worth in aUEC is on the
  <a href="/admin/scrip">Scrip</a> page, for every tool.</p>
<div class="card">
  <table class="narrow">
    <thead><tr><th>Scenario</th><th class="right">aUEC</th><th class="right">MG scrip</th></tr></thead>
    <tbody>
    @for (var n = 1; n <= GauntletRewards.Scenarios; n++)
    {
      <tr>
        <td><a href="/admin/missions#@MissionLibrary.Anchor(GauntletService.LibraryKey(n))">#@n</a></td>
        <td class="right">@N(Model.Rewards[n].Auec)</td>
        <td class="right">@N(Model.Rewards[n].Scrip)</td>
      </tr>
    }
    </tbody>
  </table>
  <p class="hint">What a completed run pays. A reward nobody knows counts 0.</p>
</div>
