@model List<ToolLine>
@{
    ViewData["Title"] = "Tools";
}
<h1>Tools</h1>
<p class="muted">Which tools everybody sees on the front page (the Party: its button in the top bar). A tool that is not ticked is only for you: its card on the
  front page and its page need your admin login. A change is saved as soon as you make it.</p>

@* every tick is a little form of its own (data-autosave: autosave.js sends it when it changes) *@
<table>
  <thead><tr><th>Tool</th><th>Shown to everybody</th><th>Page</th></tr></thead>
  <tbody>
  @foreach (var line in Model)
  {
    <tr>
      <td>@line.Tool.Name</td>
      <td class="center">
        <form method="post" action="/admin/tools/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="id" value="@line.Tool.Id">
          <input type="checkbox" name="value" value="true" checked="@line.Public" aria-label="Shown to everybody">
        </form>
      </td>
      <td>
        @if (line.Tool.Path != null)
        {
          <a href="@line.Tool.Path">@line.Tool.Path</a>
        }
        else
        {
          <span class="muted">Coming</span>
        }
      </td>
    </tr>
  }
  </tbody>
</table>
