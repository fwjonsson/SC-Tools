@{
    ViewData["Title"] = "Map";
}
@* no text over the map (Frank, 30 Oct 2026); how the map places everybody is in the README *@
@section subnav {
  @* the systems as a row under the bar in the tool's colour, like the admin's pages (Frank, 30 Oct 2026); map.js fills it with a button per system. At the
     right end the team status line (ticker.js), as on the other gameplay tools (Frank, 31 Oct 2026) *@
  <nav class="subnav area" style="--tool:@SiteTools.Map.Color"><div class="tabs" id="systems" role="tablist" aria-label="Star system"></div><span class="ticker" data-ticker></span></nav>
  <script src="~/ticker.js" asp-append-version="true" defer></script>
}
<div class="maptool maponly">
  <div class="mapbox">
    <div id="map"></div>
    <p class="hint">Positions: the <a href="https://api.star-citizen.wiki" rel="noopener">Star Citizen Wiki API</a>. A moon, a city or a station close
      to a planet is drawn at the planet (point at it for what is there).</p>
  </div>
  @* beside the map the players; the objectives list and the Active Contracts went to the Companion (#380), and the map got the room *@
  <div class="mapside players">
    <h2>Players</h2>
    <div id="players"><p class="muted">Loading…</p></div>
  </div>
</div>
<p class="hint" id="mapState"></p>
@if (User.IsInRole(Roles.Admin))
{
  <p class="hint"><a href="/admin/places">Map places</a>: say what a destination the map does not know is, rename a place, add one.</p>
}
<script src="~/systemmap.js" asp-append-version="true" defer></script>
<script src="~/map.js" asp-append-version="true" defer></script>
