@model KeysModel
@{
    ViewData["Title"] = "Tracker keys";
}
<h1>Tracker keys</h1>
<p class="muted">Every tracker uploads with its own key, and the key is the player. A new key is shown once; the database keeps only a hash of it.</p>

<form method="post" action="/admin/keys" asp-antiforgery="true" class="card">
  <label asp-for="New.Player"></label>
  <input asp-for="New.Player" list="party" autocomplete="off">
  <datalist id="party">
    @foreach (var name in Model.Party)
    {
      <option value="@name"></option>
    }
  </datalist>
  <span asp-validation-for="New.Player" class="error"></span>
  <button type="submit">Make a key</button>
</form>

<h2>Keys</h2>
@if (Model.Keys.Count == 0)
{
  <p class="muted">No keys yet.</p>
}
else
{
  <table>
    <thead><tr><th>Player</th><th>Made</th><th>Tracker</th><th></th></tr></thead>
    <tbody>
    @foreach (var k in Model.Keys)
    {
      <tr>
        <td>@k.Player</td>
        <td>@k.Created</td>
        <td class="@(k.Newest == true ? "good" : k.Newest == false ? "stale" : "muted")">@k.Tracker</td>
        <td class="right">
          <form method="post" action="/admin/keys/@k.Id/remove" asp-antiforgery="true" class="inline" onsubmit="return confirm('Take back this key of @k.Player? His tracker stops uploading until it gets a new key.');">
            <button type="submit" class="danger">Take back</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
}
