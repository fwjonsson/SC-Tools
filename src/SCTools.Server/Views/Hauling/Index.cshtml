@{
    ViewData["Title"] = "Hauling Planner";
    // who is looking (hauling.js reads it): a player logged in by his tracker, or the admin, who gets the list of whose session the tabs show
    var me = (User.Identity?.IsAuthenticated == true ? User.Identity.Name : null) ?? "";
    var admin = User.IsInRole(Roles.Admin);
}
@* The Hauling Planner, an ordinary page of the site since 29 Oct 2026 (Frank): the site's bar and look, hauling.css and hauling.js for its own tables, tabs
   and map (systemmap.js, the one map engine). Every tab has its own address (/hauling/<tab>, PageController) and the script shows that tab. *@
<link rel="stylesheet" href="~/hauling.css" asp-append-version="true">
@* the admin gets data-admin (Razor writes a data- attribute even when its value is null, so it is written by hand) *@
<div class="hauling" data-me="@me"@(admin ? Html.Raw(" data-admin=\"1\"") : null)>
<!-- the title, the tabs and what they show on the left; on the Session tab the Party table beside them, level with the title, and the session under it (the
     leaderboard and the runs under both, over the whole width). After the tabs, for the admin only, the party whose session the tabs show -->
<div class="top">
<div class="main">
<h1>Hauling Planner</h1>
<div class="bar"><span id="session"></span><span id="live" class="live"></span><span id="updated"></span></div>
<div class="nav"><button id="tabS" class="on">Session</button><button id="tabC">Contracts</button><button id="tabP">Trip Planner</button><button id="tabD">Debts</button><button id="tabH">History</button><select id="partyPick" class="hidden" aria-label="Whose session"></select></div>

<div id="viewS">
  <p class="note hidden" id="partyNote"></p>
  <h2>Stops</h2><div class="scroll" id="pickups"></div>
  <div id="finishedBox"><h2>Finished stops</h2><div class="scroll" id="finished"></div></div>
  <div id="jobsBox" class="hidden"><h2>Other hauling</h2><div class="scroll" id="jobs"></div><p class="note" id="jobsNote"></p></div>
</div>

<div id="viewC" class="hidden">
  <h2>Contracts</h2><p class="note" id="rewardsParty"></p><div class="scroll" id="rewards"></div>
  <p class="note">What every contract line pays (set in the Mission Library), how many of them are active and completed, and what they earned.</p>
</div>

<div id="viewP" class="hidden">
  <div id="planNote" class="empty"></div>
  <div id="planBody"></div>
</div>

<div id="viewD" class="hidden"></div>
<div id="viewH" class="hidden"></div>
</div>

<div class="side" id="sideS">
  <div class="scroll" id="party" aria-label="Party"></div>
  <h2>Session</h2><div class="scroll" id="summary"></div>
</div>
</div>

<div id="belowS">
<h2>Session leaderboard</h2><div class="scroll" id="leaders"></div>
<h2>Cargo runs</h2><div class="scroll" id="runs"></div>
</div>
</div>
<script src="~/systemmap.js" asp-append-version="true"></script>
<script src="~/hauling.js" asp-append-version="true"></script>
