@inject ToolAccess Tools
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] - SC Tools</title>
<link rel="icon" href="/favicon.ico" type="image/x-icon">
<link rel="stylesheet" href="~/site.css" asp-append-version="true">
<link rel="stylesheet" href="~/topbar.css" asp-append-version="true">
<script src="~/autosave.js" asp-append-version="true" defer></script>
<script src="~/live.js" asp-append-version="true" defer></script>
@if (User.IsInRole(Roles.Admin))
{
  @* the admin's notice of unknown places, on every page he has open (#414) *@
  <script src="~/alerts.js" asp-append-version="true" defer></script>
}
</head>
@{
    // the tables' heads and the buttons in the colour of the tool the page is (TopBar.ColorOf; Frank, 31 Oct 2026), mixed into the dark as the site's blue is
    var toolColor = TopBar.ColorOf(Context);
    var bodyStyle = toolColor == null ? null : "--header:color-mix(in srgb, " + toolColor + " 42%, #0d1117)";
}
<body style="@bodyStyle">
@* the bar of the site (TopBar.cs, the same on the tools' own pages); under it on the admin's pages, his pages *@
@Html.Raw(TopBar.Html(Context, Tools))
@if (TopBar.InAdmin(Context))
{
  var path = (Context.Request.Path.Value ?? "").TrimEnd('/');
  bool On(string href) => href == "/admin" ? string.Equals(path, href, StringComparison.OrdinalIgnoreCase) : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
  <nav class="subnav area" style="--tool:@TopBar.AdminColor">
    @foreach (var (href, text) in new[] { ("/admin", "Session"), ("/admin/players", "Players"), ("/admin/debts", "Debts"),
                                         ("/admin/scrip", "Scrip"), ("/admin/places", "Map places"), ("/admin/map", "Map"),
                                         ("/admin/tools", "Tools"),
                                         ("/account", "Account") })
    {
      <a href="@href" class="@(On(href) ? "on" : null)">@text</a>
    }
  </nav>
}
@* a tool with tabs has them as the same kind of row, in its own colour (Frank, 30 Oct 2026): the tool's view gives the row in its subnav section. The tools'
   pages have no title of their own: the bar says where you are *@
@RenderSection("subnav", required: false)
<main>
  @if (TempData["Message"] is string message)
  {
    <p class="message">@message</p>
  }
  @RenderBody()
</main>
<footer class="sitefoot">
  <div class="links">
    <a class="dl" href="@SCTools.Server.Controllers.TrackerController.Download"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"/></svg>SC Tools Tracker</a>
    <a href="/tracker">How to set it up</a>
  </div>
  <p>An unofficial Star Citizen fan site, not affiliated with the Cloud Imperium group of companies.</p>
  <p>Game data from the Star Citizen Wiki (api.star-citizen.wiki) and UEX (uexcorp.space), from our own game logs, and what we fill in ourselves.</p>
</footer>
</body>
</html>
