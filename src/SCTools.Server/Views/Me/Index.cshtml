@model MeModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "My page";
    IEnumerable<SelectListItem> Items(List<Choice> choices) => choices.Select(c => new SelectListItem(c.Text, c.Value));
}
<h1>@Model.Player.ToUpperInvariant()</h1>
@if (!Model.InParty)
{
  <p class="muted">You are not in the party yet: what you set here is kept, and used once Frank adds you.</p>
}
<form method="post" action="/me" asp-antiforgery="true" class="card">
  <label asp-for="Location">Current location</label>
  <select asp-for="Location" asp-items="Items(Model.Stations)">
    <option value="">Automatic: @Model.AutoLocation</option>
  </select>
  <p class="hint">Automatic follows your pickups, deliveries and hand-ins. A station you pick holds until the logs show you moving (a pickup, a delivery, a hand-in, waste or a quantum jump).</p>

  <label for="Color">Colour</label>
  <input type="color" id="Color" name="Color" value="@Model.Color">
  <p class="hint">Your colour on the Route Planner, its map and the Party panel.</p>

  <button type="submit">Save</button>
</form>

@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Speed(double? mps) => mps == null ? "" : mps.Value.ToString("N0", inv) + " m/s";
    // the drives to pick from: a ship takes the size of its stock drive (Frank, 29 Oct 2026), so only those are listed; every size for a ship the site does not know
    IEnumerable<QtDrive> Drives(int? size) => QuantumDrives.All.Where(d => size == null || d.Size == size).OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase).ThenBy(d => d.Size);
    var active = Model.Active;
    var auto = active == null || active.Vehicle == null
        ? "no quantum jump in your logs yet"
        : (active.Picked ? VehicleLines.Pretty(active.Vehicle) : active.Text) + " (your last quantum jump" + (active.Picked || active.Ship != null ? "" : ", not in your fleet") + ")";
}
<h2 id="fleet">My fleet</h2>
<p class="hint">Every ship you own and the quantum drive in it (none picked: the ship's stock drive; only the drives of the size the ship takes are listed). A crafted drive: type its quality (0 to 1000). Quality
  1000 makes the drive speed 20 % higher, 500 is as bought, 0 is 20 % lower (only the drive speed changes). The Hauling Planner flies your active ship: its cargo grid, its drive and the drive's
  speed for the flying times.</p>
<form method="post" action="/me/fleet/active" asp-antiforgery="true" class="line" data-autosave>
  <label for="activeShip">Active ship</label>
  <select id="activeShip" name="id">
    <option value="" selected="@(active?.Picked != true)">Automatic: @auto</option>
    @foreach (var s in Model.Fleet)
    {
      <option value="@s.Row.Id" selected="@(active?.Picked == true && active.Ship?.Row.Id == s.Row.Id)">@s.Row.Ship</option>
    }
  </select>
</form>
@if (Model.Fleet.Count > 0)
{
  <div class="scroll">
  <table class="wide fleet">
    <thead><tr><th>Ship</th><th>Quantum drive</th><th>Crafted quality</th><th class="right">Drive speed</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model.Fleet)
    {
      <tr class="@(active?.Ship?.Row.Id == s.Row.Id ? "on" : null)">
        <td>
          <form method="post" action="/me/fleet/set" asp-antiforgery="true" data-autosave>
            <input type="hidden" name="id" value="@s.Row.Id"><input type="hidden" name="field" value="ship">
            <input name="value" value="@s.Row.Ship" list="shipNames" maxlength="@FleetService.MaxName" aria-label="Ship" class="name" autocomplete="off">
          </form>
          @if (s.Model == null)
          {
            <span class="muted small">not a ship the site knows</span>
          }
          else if (s.Hauler == null && s.Model.Cargo >= 32)
          {
            <span class="muted small">not a hauler the planner knows</span>
          }
        </td>
        <td>
          <form method="post" action="/me/fleet/set" asp-antiforgery="true" data-autosave>
            <input type="hidden" name="id" value="@s.Row.Id"><input type="hidden" name="field" value="drive">
            <select name="value" aria-label="Quantum drive">
              <option value="">@(s.StockDrive is { } stock ? "Stock: " + stock.Label : "")</option>
              @foreach (var d in Drives(s.DriveSize))
              {
                <option value="@d.Label" selected="@(s.Row.Drive != null && s.Drive?.Label == d.Label)">@d.Label</option>
              }
            </select>
          </form>
        </td>
        <td>
          <form method="post" action="/me/fleet/set" asp-antiforgery="true" data-autosave>
            <input type="hidden" name="id" value="@s.Row.Id"><input type="hidden" name="field" value="quality">
            <input name="value" value="@s.Row.Quality" inputmode="numeric" placeholder="not crafted" aria-label="Crafted quality" class="num" autocomplete="off">
          </form>
        </td>
        <td class="right nowrap">@Speed(s.Speed)@(s.Bonus == 0 ? "" : " (" + QuantumDrives.PercentText(s.Bonus) + ")")</td>
        <td class="right">
          <form method="post" action="/me/fleet/remove" asp-antiforgery="true" class="inline" onsubmit="return confirm('Take @s.Row.Ship out of your fleet?');">
            <input type="hidden" name="id" value="@s.Row.Id">
            <button type="submit" class="danger">Remove</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
  </div>
}
<form method="post" action="/me/fleet/add" asp-antiforgery="true" class="line">
  <input name="ship" list="shipNames" maxlength="@FleetService.MaxName" placeholder="Ship" aria-label="Ship to add" required autocomplete="off">
  @* every drive, with its size: the script below keeps only the ones of the size the ship typed takes (ShipSizes) *@
  <select name="drive" aria-label="Its quantum drive" id="addDrive" data-sizes="@System.Text.Json.JsonSerializer.Serialize(Model.ShipSizes)">
    <option value="">Stock quantum drive</option>
    @foreach (var d in Drives(null))
    {
      <option value="@d.Label" data-size="@d.Size">@d.Label</option>
    }
  </select>
  <input name="quality" inputmode="numeric" placeholder="Crafted quality" aria-label="Crafted quality" class="num" autocomplete="off">
  <button type="submit">Add ship</button>
</form>
<datalist id="shipNames">
  @foreach (var n in Model.ShipNames)
  {
    <option value="@n"></option>
  }
</datalist>
<script>
// Add ship: once the ship typed is one the site knows, only the drives of the size it takes are left to pick (the server refuses another size anyway)
(function () {
  var ship = document.querySelector('input[name="ship"][list="shipNames"]'), drive = document.getElementById('addDrive');
  if (!ship || !drive) return;
  var sizes = JSON.parse(drive.dataset.sizes || '{}');
  function fit() {
    var size = sizes[ship.value.trim().toLowerCase()];
    Array.prototype.forEach.call(drive.options, function (o) { if (o.dataset.size) o.hidden = !!size && +o.dataset.size !== size; });
    if (drive.selectedOptions[0] && drive.selectedOptions[0].hidden) drive.value = '';
  }
  ship.addEventListener('input', fit);
  fit();
})();
</script>
