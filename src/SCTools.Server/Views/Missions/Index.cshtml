@model MissionLibraryPage
@using System.Globalization
@using SCTools.Server.Controllers
@using SCTools.Tracking
@{
    // the Mission Library to look up (/missions, read-only) and Edit Mission Info (/admin/missions, the admin's, a field in every cell): the same list,
    // choices and order
    var inv = CultureInfo.InvariantCulture;
    string N(long? v) => v?.ToString(inv) ?? "";   // in a field: no thousands separators
    string G(long? v) => v?.ToString("N0", inv) ?? "";   // in a cell
    // the Star Citizen Wiki's SCU for the kind's contract (the middle of its hauling orders), when no SCU is suggested
    string WikiScu(WikiContract? w) => w != null && w.Orders.Count > 0 ? "~" + N((long)Math.Round(w.Total.Middle)) : "";
    var f = Model.Filter;
    var path = Model.Path;
    var back = Model.Link(Model.Page);
    var edit = Model.Editable;
    var me = Model.Viewer;
    var admin = User.IsInRole(Roles.Admin);
    // the columns, with the key they sort by (a header is a link: again for the other way round)
    var columns = new List<(string Key, string Text, string? Cls)> { ("name", "Mission", null), ("giver", "Giver", null), ("scu", "SCU", "right"), ("auec", "aUEC", "right"),
        ("mg", "MG<br>scrip", "right"), ("council", "Council<br>scrip", "right") };
    if (me != null) columns.Add(("played", "Played<br>by me", "right"));
    string Arrow(string key) => f.Sort == key ? (f.Desc ? " ▾" : " ▴") : "";
}
<h1>@(edit ? "Edit Mission Info" : "Mission Library")</h1>
@if (edit)
{
<p class="muted">The Mission Library as you change it: every mission anybody took is here by itself, from the logs (the old ones too), one row per name
  (the same mission at another place is the same row; the contracts the Hauling Planner reads are one row per contract line, which is what they pay by).
  Type in what the log does not say: it is saved as soon as you leave the field. The Session tool counts what everybody's missions earned with these
  rewards, the Gauntlet Tracker with the ones of the Combat Gauntlet scenarios, and the Hauling Planner pays the aUEC of the Hauling rows and plans with
  the SCU. Everybody else sees it read-only on the <a href="@MissionsController.Path">Mission Library</a>.</p>
}
else
{
<p class="muted">Every mission we take is here by itself, from our logs (the old ones too), one row per name: the same mission at another place is the same
  row, and the contracts the Hauling Planner reads are one row per contract line (Hauling: 2 To Ruin...), which is what they pay by. With it is what the
  log does not say: the aUEC, MG scrip and Council scrip it pays, its cargo in SCU and the giver. The Session tool counts what your missions earned with
  these rewards, the Gauntlet Tracker with the ones of the Combat Gauntlet scenarios, and the Hauling Planner pays the aUEC of the Hauling rows and plans
  with the SCU. Choose what to see below, and click a column to sort by it.@if (admin) { <text> You change it on <a href="@EditMissionsController.Path">Edit Mission Info</a>.</text> }</p>
}

<form method="get" action="@path" class="line filters">
  <input name="q" value="@f.Q" placeholder="Find a mission or a giver" aria-label="Find">
  <select name="giver" aria-label="Giver">
    <option value="">Every giver</option>
    @foreach (var g in Model.Givers)
    {
      <option value="@g" selected="@(string.Equals(g, f.Giver, StringComparison.OrdinalIgnoreCase))">@g</option>
    }
  </select>
  <select name="rewards" aria-label="Rewards">
    <option value="all" selected="@(f.Rewards == "all")">All (@Model.Total)</option>
    <option value="known" selected="@(f.Rewards == "known")">With rewards (@Model.Known)</option>
    <option value="todo" selected="@(f.Rewards == "todo")">Without rewards (@Model.ToDo)</option>
  </select>
  @if (me != null)
  {
    <label class="check"><input type="checkbox" name="mine" value="1" checked="@f.Mine"> Played by me (@Model.Mine)</label>
  }
  @if (f.Sort != LibraryFilter.DefaultSort || f.Desc)
  {
    <input type="hidden" name="sort" value="@f.Sort"><input type="hidden" name="dir" value="@(f.Desc ? "desc" : "asc")">
  }
  <button type="submit">Show</button>
  @if (!f.IsDefault) { <a href="@path" class="small">Show all</a> }
</form>
@if (edit)
{
<p class="hint autosave-state" id="autosaveState" aria-live="polite"></p>
}

@* what changes as missions come in: made again by missions.js when the library's version is not this one any more (not while you are typing in it) *@
<div id="library" data-version="@Model.Version" data-version-url="@(path + "/version")">
@if (edit)
{
@* every giver typed in so far, to pick in a Giver field (autosave.js adds a new one as soon as it is saved) *@
<datalist id="givers">
  @foreach (var g in Model.Givers)
  {
    <option value="@g"></option>
  }
</datalist>
}

@if (Model.Entries.Count == 0)
{
  <p class="card">@(Model.Total == 0 ? "No missions yet: they come in from the trackers as we play." : "Nothing here.")</p>
}
else
{
  @* editable: every field is a little form of its own (data-autosave: autosave.js sends it when it changes) *@
  <div class="scroll">
  <table class="wide missions@(edit ? "" : " view")">
    <thead><tr>
    @foreach (var (key, text, cls) in columns)
    {
      <th class="@cls"><a href="@Model.SortLink(key)" class="@(f.Sort == key ? "on" : null)" title="Sort by it">@Html.Raw(text)@Arrow(key)</a></th>
    }
    </tr></thead>
    <tbody>
    @foreach (var e in Model.Entries)
    {
      var r = e.Row;
      var mine = e.PlaysOf(me);
      var running = mine?.Running == true;
      <tr id="@e.Anchor" class="@(string.Join(" ", new[] { e.NeedsInfo ? "todo" : null, running ? "running" : null }.Where(c => c != null)) is { Length: > 0 } c ? c : null)">
        @if (edit)
        {
          foreach (var (field, value, cls, hint) in new[]
          {
              ("name", r.Name ?? r.Title, "name", r.Title),
              ("giver", r.Giver ?? "", "giver", "Type or pick"),
              ("scu", N(r.Scu), "num scu", r.ScuSuggested != null ? N(r.ScuSuggested) : WikiScu(e.Wiki)),
              ("auec", N(r.Auec), "num", e.Wiki?.AuecText ?? ""),
              ("mg", N(r.MgScrip), "num scrip", ""),
              ("council", N(r.CouncilScrip), "num scrip", ""),
          })
          {
            <td>
              <form method="post" action="@(path + "/set")" asp-antiforgery="true" data-autosave="quiet">
                <input type="hidden" name="id" value="@r.Key"><input type="hidden" name="field" value="@field"><input type="hidden" name="back" value="@back">
                <input name="value" value="@value" placeholder="@hint" class="@cls" aria-label="@field" autocomplete="off" list="@(field == "giver" ? "givers" : null)">
              </form>
              @if (field == "name" && e.UsedBy != null)
              {
                <span class="used muted small">@e.UsedBy</span>
              }
            </td>
          }
        }
        else
        {
          <td class="name" title="@(r.Name != null && r.Name != r.Title ? "The game calls it " + r.Title : null)">@e.Shown
            @if (e.UsedBy != null) { <span class="used muted small">@e.UsedBy</span> }
          </td>
          <td>@(r.Giver ?? "")</td>
          <td class="right nowrap">@if (r.Scu != null) { @G(r.Scu) }
            else if (r.ScuSuggested != null) { <span class="muted" title="suggested by @r.ScuSuggestedBy">@G(r.ScuSuggested)</span> }
            else if (WikiScu(e.Wiki) is { Length: > 0 } ws) { <span class="muted" title="the Star Citizen Wiki's hauling orders">@ws</span> }</td>
          <td class="right nowrap">@if (r.Auec != null) { @G(r.Auec) } else if (e.Wiki?.AuecText is { Length: > 0 } wa) { <span class="muted" title="the Star Citizen Wiki's reward">@wa</span> }</td>
          <td class="right">@G(r.MgScrip)</td>
          <td class="right">@G(r.CouncilScrip)</td>
        }
        @if (me != null)
        {
          <td class="right nowrap" title="@(mine == null ? "never" : $"taken {mine.Taken}, completed {mine.Completed}, failed {mine.Failed}, abandoned {mine.Abandoned}")">@if (mine != null) { <text>@mine.Completed / @mine.Taken</text> }@if (running) { <span class="now">playing now</span> }</td>
        }
      </tr>
    }
    </tbody>
  </table>
  </div>
  @if (Model.Pages > 1)
  {
    <nav class="pager" aria-label="Pages">
      @if (Model.Page > 1) { <a href="@Model.Link(Model.Page - 1)">« Previous</a> } else { <span class="muted">« Previous</span> }
      <span>Page @Model.Page of @Model.Pages <span class="muted">(@Model.Found)</span></span>
      @if (Model.Page < Model.Pages) { <a href="@Model.Link(Model.Page + 1)">Next »</a> } else { <span class="muted">Next »</span> }
    </nav>
  }
  <p class="hint">@if (me != null) { <text>Played by me: how often you completed it of how often you took it (hover for failed and abandoned); a green row is one
    you are playing now. </text> }A grey aUEC is the Star Citizen Wiki's reward for the mission (it counts until one is typed in); a grey SCU is the one suggested last
    (what a hauler typed in for one of these missions on the <a href="/hauling">Hauling Planner</a>'s Other hauling board, or what the game said) or the
    Wiki's, and one typed in here wins over it; an empty cell means not known (an empty Hauling aUEC: the Hauling Planner's built-in reward).
    @if (edit) { <text>Rewards and SCU are whole numbers. A grey name is the one the game shows.</text> } else { <text>Hover a name to see what the game calls it when it
    was renamed.</text> }
    Click a column to sort by it, again for the other way round. @MissionsController.PageSize to a page.</p>
}
</div>
<script src="~/missions.js" asp-append-version="true" defer></script>
