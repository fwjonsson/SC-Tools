@model MissionLibraryPage
@using System.Globalization
@using SCTools.Server.Controllers
@using SCTools.Tracking
@{
    // the Mission Library: to look up, and for the admin a field in every cell to fill in (Edit Mission Info, his page of its own, went on 31 Oct 2026)
    var inv = CultureInfo.InvariantCulture;
    string N(long? v) => v?.ToString(inv) ?? "";   // in a field: no thousands separators
    string G(long? v) => v?.ToString("N0", inv) ?? "";   // in a cell
    // the Star Citizen Wiki's SCU for the kind's contract (the middle of its hauling orders), when no SCU is suggested
    string WikiScu(WikiContract? w) => w != null && w.Orders.Count > 0 ? "~" + N((long)Math.Round(w.Total.Middle)) : "";
    var f = Model.Filter;
    var path = Model.Path;
    var back = Model.Link(Model.Page);
    var edit = Model.Editable;
    var me = Model.Viewer;
    var admin = User.IsInRole(Roles.Admin);
    // the columns, with the key they sort by (a header is a link: again for the other way round); Faction, Category, XP and Legality are the Star Citizen
    // Wiki's (the faction typed in wins), Reward is the aUEC typed in, else the Wiki's reward
    var columns = new List<(string Key, string Text, string? Cls)> { ("name", "Mission", null), ("faction", "Faction", null), ("category", "Category", null),
        ("scu", "SCU", "right"), ("auec", "Reward", "right"), ("mg", "MG<br>scrip", "right"), ("council", "Council<br>scrip", "right"), ("xp", "XP", "right"),
        ("legality", "Legality", null) };
    if (me != null)
    {
        columns.Add(("played", "Failed /<br>Completed", "right"));
        columns.Add(("last", "Last<br>played", null));
    }
    string When(DateTime? utc) => utc == null ? "" : utc.Value.ToLocalTime().ToString("d MMM yyyy", inv);
    string Arrow(string key) => f.Sort == key ? (f.Desc ? " \u25be" : " \u25b4") : "";
}
@if (edit)
{
<p class="muted">Every mission anybody took is here by itself, from the logs (the old ones too), one row per name (the same mission at another place is the
  same row; the contracts the Hauling Planner reads are rows by their names too, and the planner pays each contract what its row says).
  As the admin you type in what the log does not say: it is saved as soon as you leave the field. Session History counts what everybody's missions earned
  with these rewards, the Gauntlet Tracker with the ones of the Combat Gauntlet scenarios, and the Hauling Planner pays the aUEC of the Hauling rows and
  plans with the SCU. The Faction, Category, Reward, XP and Legality in grey are the Star Citizen Wiki's (a faction or a reward typed in wins). Everybody
  else sees the same list without the fields.</p>
@* a contract screenshot read into the library (#437): only the admin; the text is read in his browser (screenshot.js, Tesseract), then he checks and saves *@
<section class="card shot" id="shot" data-read-url="@(EditMissionsController.Path + "/screenshot")" data-save-url="@(EditMissionsController.Path + "/screenshot/save")">
  <form id="shotToken" method="post" action="@(EditMissionsController.Path + "/screenshot/save")" asp-antiforgery="true"></form>
  <h2>Read a contract screenshot</h2>
  <div class="paste" tabindex="0" role="button" data-shot-paste>Click here and press <b>Ctrl+V</b> with a screenshot of a contract in the mobiGlas
    (its card: the name, the Reward and Contracted By showing), or drop the screenshot file here.</div>
  <p class="hint" data-shot-status aria-live="polite">The text is read in your browser with Tesseract, a free text reader (the first time it fetches about
    10 MB): the name, the reward, the faction and the MG or Council scrip of the description. You check it before it is saved.</p>
  <div data-shot-result hidden></div>
</section>
}
else
{
<p class="muted">Every mission we take is here by itself, from our logs (the old ones too), one row per name: the same mission at another place is the same
  row, and the contracts the Hauling Planner reads are rows by their names too (the planner pays each contract what its row says). With it is what the
  Star Citizen Wiki says about the mission (the faction, the category, the reward, the XP and whether it is legal) and what we fill in ourselves (the reward
  in aUEC, MG scrip and Council scrip, its cargo in SCU, the faction). The Session tool counts what your missions earned with these rewards, the Gauntlet
  Tracker with the ones of the Combat Gauntlet scenarios, and the Hauling Planner pays the aUEC of the Hauling rows and plans with the SCU. Choose what
  to see below, and click a column to sort by it.</p>
}

<form method="get" action="@path" class="line filters">
  <input name="q" value="@f.Q" placeholder="Find a mission, a faction or a category" aria-label="Find">
  <select name="faction" aria-label="Faction">
    <option value="">Every faction</option>
    @foreach (var g in Model.Factions)
    {
      <option value="@g" selected="@(string.Equals(g, f.Faction, StringComparison.OrdinalIgnoreCase))">@g</option>
    }
  </select>
  <select name="rewards" aria-label="Rewards">
    <option value="all" selected="@(f.Rewards == "all")">All (@Model.Total)</option>
    <option value="known" selected="@(f.Rewards == "known")">With rewards (@Model.Known)</option>
    <option value="todo" selected="@(f.Rewards == "todo")">Without rewards (@Model.ToDo)</option>
  </select>
  @if (me != null)
  {
    <label class="check"><input type="checkbox" name="mine" value="1" checked="@f.Mine"> Played by me (@Model.Mine)</label>
  }
  @if (f.Sort != LibraryFilter.DefaultSort || f.Desc)
  {
    <input type="hidden" name="sort" value="@f.Sort"><input type="hidden" name="dir" value="@(f.Desc ? "desc" : "asc")">
  }
  <button type="submit">Show</button>
  @if (!f.IsDefault) { <a href="@path" class="small">Show all</a> }
</form>
@if (edit)
{
<p class="hint autosave-state" id="autosaveState" aria-live="polite"></p>
}

@* what changes as missions come in: made again by missions.js when the library's version is not this one any more (not while you are typing in it) *@
<div id="library" data-version="@Model.Version" data-version-url="@(path + "/version")">
@if (edit)
{
@* every faction so far (typed in, or the Wiki's), to pick in a Faction field (autosave.js adds a new one as soon as it is saved) *@
<datalist id="factions">
  @foreach (var g in Model.Factions)
  {
    <option value="@g"></option>
  }
</datalist>
}

@if (Model.Entries.Count == 0)
{
  <p class="card">@(Model.Total == 0 ? "No missions yet: they come in from the trackers as we play." : "Nothing here.")</p>
}
else
{
  @* editable: every field is a little form of its own (data-autosave: autosave.js sends it when it changes) *@
  @* the rows are numbered in a # column on the left (Frank, 30 Oct 2026), on through the pages *@
  var first = (Model.Page - 1) * MissionsController.PageSize;
  var row = 0;
  <div class="scroll">
  <table class="wide missions@(edit ? "" : " view")">
    <thead><tr>
    <th class="right">#</th>
    @foreach (var (key, text, cls) in columns)
    {
      <th class="@cls"><a href="@Model.SortLink(key)" class="@(f.Sort == key ? "on" : null)" title="Sort by it">@Html.Raw(text)@Arrow(key)</a></th>
    }
    </tr></thead>
    <tbody>
    @foreach (var e in Model.Entries)
    {
      var r = e.Row;
      var w = e.Wiki;
      var mine = e.PlaysOf(me);
      var running = mine?.Running == true;
      <tr id="@e.Anchor" class="@(string.Join(" ", new[] { e.NeedsInfo ? "todo" : null, running ? "running" : null }.Where(c => c != null)) is { Length: > 0 } c ? c : null)">
        <td class="right muted">@(first + ++row)</td>
        @if (edit)
        {
          @* a field where something can be typed in (Field), else the Wiki's text (Text), in the order of the columns *@
          foreach (var (field, value, cls, hint, text) in new (string? Field, string Value, string Cls, string Hint, string? Text)[]
          {
              ("name", r.Name ?? r.Title, "name", r.Title, null),
              ("giver", r.Giver ?? "", "giver", w?.Faction ?? "Type or pick", null),
              (null, "", "", "", e.Category),
              ("scu", N(r.Scu), "num scu", r.ScuSuggested != null ? N(r.ScuSuggested) : WikiScu(w), null),
              ("auec", N(r.Auec), "num", w?.RewardText ?? "", null),
              ("mg", N(r.MgScrip), "num scrip", "", null),
              ("council", N(r.CouncilScrip), "num scrip", "", null),
              (null, "", "right", "", G(e.Xp)),
              (null, "", "", "", e.Legality),
          })
          {
            if (field == null)
            {
              <td class="@(cls.Length > 0 ? cls : null)">@if (text is { Length: > 0 }) { <span class="muted" title="the Star Citizen Wiki's">@text</span> }</td>
              continue;
            }
            <td>
              <form method="post" action="@(EditMissionsController.Path + "/set")" asp-antiforgery="true" data-autosave="quiet">
                <input type="hidden" name="id" value="@r.Key"><input type="hidden" name="field" value="@field"><input type="hidden" name="back" value="@back">
                <input name="value" value="@value" placeholder="@hint" class="@cls" aria-label="@(field == "giver" ? "faction" : field)" autocomplete="off" list="@(field == "giver" ? "factions" : null)">
              </form>
            </td>
          }
        }
        else
        {
          <td class="name" title="@(r.Name != null && r.Name != r.Title ? "The game calls it " + r.Title : null)">@e.Shown</td>
          @if (r.Giver?.Trim() is { Length: > 0 } typed) { <td>@typed</td> }
          else { <td>@if (w?.Faction is { Length: > 0 } wf) { <span class="muted" title="the Star Citizen Wiki's faction">@wf</span> }</td> }
          <td>@if (e.Category is { Length: > 0 } cat) { <span class="muted" title="the Star Citizen Wiki's category">@cat</span> }</td>
          <td class="right nowrap">@if (r.Scu != null) { @G(r.Scu) }
            else if (r.ScuSuggested != null) { <span class="muted" title="suggested by @r.ScuSuggestedBy">@G(r.ScuSuggested)</span> }
            else if (WikiScu(w) is { Length: > 0 } ws) { <span class="muted" title="the Star Citizen Wiki's hauling orders">@ws</span> }</td>
          <td class="right nowrap">@if (r.Auec != null) { @G(r.Auec) } else if (w?.RewardText is { Length: > 0 } wr) { <span class="muted" title="the Star Citizen Wiki's reward">@wr</span> }</td>
          <td class="right">@G(r.MgScrip)</td>
          <td class="right">@G(r.CouncilScrip)</td>
          <td class="right">@if (e.Xp != null) { <span class="muted" title="the reputation the Star Citizen Wiki says it gives">@G(e.Xp)</span> }</td>
          <td>@if (e.Legality is { Length: > 0 } leg) { <span class="muted" title="the Star Citizen Wiki's">@leg</span> }</td>
        }
        @if (me != null)
        {
          @* his own: how often he failed and completed it, and when he played it last (never: nothing) *@
          <td class="right nowrap" title="@(mine == null ? "never played" : $"taken {mine.Taken}, completed {mine.Completed}, failed {mine.Failed}, abandoned {mine.Abandoned}")">@if (mine != null) { <text>@mine.Failed / @mine.Completed</text> }</td>
          <td class="nowrap">@if (running) { <span class="now">playing now</span> } else { @When(mine?.LastPlayed) }</td>
        }
      </tr>
    }
    </tbody>
  </table>
  </div>
  @if (Model.Pages > 1)
  {
    <nav class="pager" aria-label="Pages">
      @if (Model.Page > 1) { <a href="@Model.Link(Model.Page - 1)">« Previous</a> } else { <span class="muted">« Previous</span> }
      <span>Page @Model.Page of @Model.Pages <span class="muted">(@Model.Found)</span></span>
      @if (Model.Page < Model.Pages) { <a href="@Model.Link(Model.Page + 1)">Next »</a> } else { <span class="muted">Next »</span> }
    </nav>
  }
  <p class="hint">@if (me != null) { <text>Failed / Completed and Last played are your own (hover the numbers for taken and abandoned); a green row is one
    you are playing now. </text> }What is grey is the Star Citizen Wiki's: the faction, the category, the reward (it counts until one is typed in), the XP (the
    reputation the mission gives) and whether it is legal; a grey SCU is the one suggested last (what a hauler typed in for one of these missions on the
    <a href="/hauling">Hauling Planner</a>'s Other hauling board, or what the game said) or the Wiki's hauling orders, and one typed in here wins over
    it; an empty cell means not known (an empty Hauling reward: the Hauling Planner's built-in one).
    @if (edit) { <text>Rewards and SCU are whole numbers. A grey name is the one the game shows.</text> } else { <text>Hover a name to see what the game calls it when it
    was renamed.</text> }
    Click a column to sort by it, again for the other way round. @MissionsController.PageSize to a page.</p>
}
</div>
<script src="~/missions.js" asp-append-version="true" defer></script>
@if (edit)
{
<script src="~/screenshot.js" asp-append-version="true" defer></script>
}
