@model List<string>
@{
    ViewData["Title"] = "Companion";
    var visitor = ViewData["Visitor"] is true;
    var editor = ViewData["Editor"] is true;
}
@* a copy of the Map tool (#380): how the map places everybody is in the README. No texts under the map and the contracts (Frank, 31 Oct 2026) *@
@section subnav {
  @* the row under the bar in the tool's colour holds the team status line (ticker.js) at its right end, as on the other gameplay tools; the systems are the map
     engine's buttons in the map's corner since 31 Oct 2026 (a row of them here before; Frank) *@
  <nav class="subnav area" style="--tool:@SiteTools.Companion.Color"><span class="ticker" data-ticker></span></nav>
  <script src="~/ticker.js" asp-append-version="true" defer></script>
}
<div class="maptool companion" data-editor="@(editor ? "true" : null)">
  <div class="mapbox">
    <div id="map"></div>
    @if (editor)
    {
      @* the admin: a card for every unknown place his accounts were at lately, with Map places' form and Later (alerts.js, #414) *@
      <div id="unknownHere"></div>
    }
  </div>
  @* beside the map you and your party; beside them your game session and the objectives *@
  <div class="mapside players">
    <h2>Players</h2>
    <div id="players"><p class="muted">Loading…</p></div>
  </div>
  <div class="mapside objectives">
    <h2>Game session</h2>
    @if (visitor)
    {
      <partial name="~/Views/Shared/LogInNote.cshtml" model="@("Your game session, your party and its contracts are here once you are logged in.")" />
    }
    else
    {
      <div id="session"><p class="muted">Loading…</p></div>
    }
    <h2>Objectives</h2>
    <div id="objectives"></div>
  </div>
  @if (!visitor)
  {
    @* under the map, the players and the session, over the whole width: the contracts going on, then the ones ended this game session *@
    <div class="mapmissions">
      @if (editor)
      {
        @Html.AntiForgeryToken()
        @* every faction so far, to pick in a Faction field (autosave.js adds a new one as soon as it is saved), as on Edit Mission Info *@
        <datalist id="factions">
          @foreach (var g in Model)
          {
            <option value="@g"></option>
          }
        </datalist>
        <p class="hint autosave-state" id="autosaveState" aria-live="polite"></p>
      }
      <h2>Active Contracts</h2>
      <div id="missions"><p class="muted">Loading…</p></div>
      <h2>Completed Contracts</h2>
      <div id="completed"><p class="muted">Loading…</p></div>
    </div>
  }
</div>
<script src="~/systemmap.js" asp-append-version="true" defer></script>
<script src="~/companion.js" asp-append-version="true" defer></script>
