@model AccountModel
@{
    ViewData["Title"] = "Account";
}
<h1>Account</h1>
<p class="muted">You log in as <b>@Model.Name</b>. The settings of the server (SCTools:Admin) are only used to make the admin the first time: change the name and the password here.</p>

<h2>Name</h2>
@if (Model.Rename.Done)
{
  <p class="message">Your name is @Model.Name now: log in with it from now on.</p>
}
<form method="post" action="/account/name" asp-antiforgery="true" class="card">
  <label asp-for="Rename.NewName"></label>
  <input asp-for="Rename.NewName" autocomplete="username">
  <span asp-validation-for="Rename.NewName" class="error"></span>
  <button type="submit">Change the name</button>
</form>

<h2>Password</h2>
@if (Model.Password.Done)
{
  <p class="message">The password is changed. If it was in the settings of the server (SCTools:Admin:Password), it can be removed from there now.</p>
}
<form method="post" action="/account/password" asp-antiforgery="true" class="card">
  <span asp-validation-for="Password" class="error"></span>
  <label asp-for="Password.Current"></label>
  <input asp-for="Password.Current" autocomplete="current-password">
  <span asp-validation-for="Password.Current" class="error"></span>
  <label asp-for="Password.New"></label>
  <input asp-for="Password.New" autocomplete="new-password">
  <span asp-validation-for="Password.New" class="error"></span>
  <label asp-for="Password.Again"></label>
  <input asp-for="Password.Again" autocomplete="new-password">
  <span asp-validation-for="Password.Again" class="error"></span>
  <button type="submit">Change the password</button>
</form>

<h2>Combined accounts</h2>
@if (Model.Combine.Done)
{
  <p class="message">@(Model.Combine.Picked.Count > 0 ? string.Join(", ", Model.Combine.Picked) + " counted with " + Model.Name + " in the money tables." : "Your account alone again in the money tables.")</p>
}
<p class="muted">Your other accounts: the money tables (the Hauling Planner's leaderboards and its Earnings table, the Gauntlet Tracker's leaderboard) get a row
  that adds them up with yours, so you can see what you earn in all, since the payouts are split between the accounts. Only there: the debts, the payouts
  and the balances stay each account's own, since the work is done on each.</p>
@if (Model.Combine.Choices.Count == 0)
{
  <p class="muted">No other players known yet.</p>
}
else
{
  <form method="post" action="/account/combine" asp-antiforgery="true" class="card">
    @foreach (var n in Model.Combine.Choices)
    {
      <label class="check"><input type="checkbox" name="names" value="@n" checked="@Model.Combine.Picked.Contains(n, StringComparer.OrdinalIgnoreCase)"> @n</label>
    }
    <button type="submit">Count them with @Model.Name</button>
  </form>
}
