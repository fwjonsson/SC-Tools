<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The web app (plan: claude/webapp-plan.md in the project): the trackers upload their Game.log lines here, the server works out the sessions with the core
       (the same logic as the program), and everybody watches the live page. The data is in a SQLite database (EF Core, Data/); the logins and the editing
       come later. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HaulingTracker.Server</RootNamespace>
    <!-- App_Data is the server's own data when it runs (the database, the logs, the data file to import): not part of the program, never copied with it -->
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <!-- the tools that make the migrations (dotnet ef); not part of the server itself -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HaulingTracker.Core/HaulingTracker.Core.csproj" />
    <ProjectReference Include="../HaulingTracker.Web/HaulingTracker.Web.csproj" />
  </ItemGroup>

</Project>
