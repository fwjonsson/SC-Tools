@model PasswordModel
@{
    ViewData["Title"] = "Password";
}
<h1>Change the password</h1>
@if (Model.Done)
{
  <p class="message">The password is changed. If it was in the settings of the server (HaulingTracker:Admin:Password), it can be removed from there now.</p>
}
<form method="post" action="/account/password" asp-antiforgery="true" class="card">
  <div asp-validation-summary="ModelOnly" class="error"></div>
  <label asp-for="Current"></label>
  <input asp-for="Current" autocomplete="current-password">
  <span asp-validation-for="Current" class="error"></span>
  <label asp-for="New"></label>
  <input asp-for="New" autocomplete="new-password">
  <span asp-validation-for="New" class="error"></span>
  <label asp-for="Again"></label>
  <input asp-for="Again" autocomplete="new-password">
  <span asp-validation-for="Again" class="error"></span>
  <button type="submit">Change it</button>
</form>
