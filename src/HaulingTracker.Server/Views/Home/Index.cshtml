@model HomeModel
@{
    ViewData["Title"] = "Home";
}
<section class="tools-intro">
  <h1>SC Tools</h1>
  <p class="muted">Star Citizen tools that read the game's own log: a tracker on every gaming PC sends what the tools need, and this site shows it to the whole party.</p>
  <p class="tracker-link"><a class="button" href="/tracker">Get the SC Tools Tracker</a> <span class="muted">the program on your gaming PC that the tools need</span></p>
</section>

@* a card for every tool this viewer sees (the Tools page says which everybody sees); the ones that are not here yet say so *@
@if (Model.Cards.Count == 0)
{
  <p class="card">Nothing here yet.</p>
}
<div class="tools">
  @foreach (var card in Model.Cards)
  {
    var tool = card.Tool;
    var state = tool.Path == null ? "Coming" : tool == SiteTools.Hauling ? (string.IsNullOrEmpty(Model.HaulingSession) ? "No session yet" : Model.HaulingSession) : tool == SiteTools.Gauntlet ? "Log in to see your runs" : "";
    if (tool.Path != null)
    {
      <a class="tool" href="@tool.Path">
        <span class="tool-name">@tool.Name</span>
        <span class="tool-text">@tool.Text</span>
        @if (card.OnlyAdmin) { <span class="tool-hidden">Only you see this</span> }
        <span class="tool-state live">@state</span>
      </a>
    }
    else
    {
      <div class="tool soon">
        <span class="tool-name">@tool.Name</span>
        <span class="tool-text">@tool.Text</span>
        @if (card.OnlyAdmin) { <span class="tool-hidden">Only you see this</span> }
        <span class="tool-state">@state</span>
      </div>
    }
  }
</div>

<p class="hint footnote">An unofficial Star Citizen fan site, not affiliated with the Cloud Imperium group of companies. Game data from the Star Citizen Wiki (api.star-citizen.wiki).</p>
