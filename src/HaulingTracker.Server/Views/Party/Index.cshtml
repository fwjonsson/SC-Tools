@model AdminPartyModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Party";
    IEnumerable<SelectListItem> Items(List<Choice> choices, string now, string? empty = "") =>
        (empty == null ? Enumerable.Empty<SelectListItem>() : new[] { new SelectListItem(empty, "", now == "") })
            .Concat(choices.Select(c => new SelectListItem(c.Text, c.Value, c.Value == now)));
    IEnumerable<SelectListItem> Batches(int now) =>
        Enumerable.Range(1, Crew.MaxShipCapacity).Select(n => new SelectListItem(n.ToString(), n.ToString(), n == now));
}
<h1>Party</h1>
<p class="muted">A change is saved as soon as you make it. Every change of Active is saved with its time, so mission payouts are split between who was there when they paid out.</p>

@* every field is a little form of its own (data-autosave: autosave.js sends it when it changes), so only that field is saved *@
<table class="wide">
  <thead><tr><th>Member</th><th>Active</th><th>Batches</th><th>Ship</th><th>QT Drive</th><th>Colour</th><th>Current location</th><th></th></tr></thead>
  <tbody>
  @foreach (var m in Model.Members)
  {
    var automatic = "Automatic: " + m.AutoLocation;
    <tr class="@(m.Active ? "" : "inactive")">
      <td><b>@m.Name.ToUpperInvariant()</b></td>
      <td class="center">
        <form method="post" action="/admin/party/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="name" value="@m.Name"><input type="hidden" name="field" value="active">
          <input type="checkbox" name="value" value="true" checked="@m.Active" aria-label="Active">
        </form>
      </td>
      <td>
        <form method="post" action="/admin/party/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="name" value="@m.Name"><input type="hidden" name="field" value="batches">
          <select name="value" asp-items="Batches(m.Batches)" class="small" aria-label="Batches"></select>
        </form>
      </td>
      <td>
        <form method="post" action="/admin/party/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="name" value="@m.Name"><input type="hidden" name="field" value="ship">
          <select name="value" asp-items="Items(Model.Ships, m.Ship)" aria-label="Ship"></select>
        </form>
      </td>
      <td>
        <form method="post" action="/admin/party/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="name" value="@m.Name"><input type="hidden" name="field" value="drive">
          <select name="value" asp-items="Items(Model.Drives, m.Drive)" aria-label="QT Drive"></select>
        </form>
      </td>
      <td class="center">
        <form method="post" action="/admin/party/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="name" value="@m.Name"><input type="hidden" name="field" value="color">
          <input type="color" name="value" value="@m.Color" aria-label="Colour">
        </form>
      </td>
      <td>
        <form method="post" action="/admin/party/set" asp-antiforgery="true" data-autosave>
          <input type="hidden" name="name" value="@m.Name"><input type="hidden" name="field" value="location">
          <select name="value" asp-items="Items(Model.Stations, m.Location, automatic)" aria-label="Current location"></select>
        </form>
      </td>
      <td class="right nowrap">
        <form method="post" action="/admin/party/remove" asp-antiforgery="true" class="inline"
              onsubmit="return confirm('Remove @m.Name from the party? His earlier work and debts stay in the Debts tab, he just stops getting a share of new payouts.');">
          <input type="hidden" name="name" value="@m.Name"><button type="submit" class="danger">Remove</button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table>

<form method="post" action="/admin/party/add" asp-antiforgery="true" class="line">
  <input name="name" placeholder="New member (his name in the game)" autocomplete="off">
  <button type="submit">Add</button>
</form>
<p class="hint">A player sets his own location, colour, ship and drive on My page too. Batches: how many his ship holds on the Trip Planner.</p>
