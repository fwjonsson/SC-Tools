@model AdminContractsModel
@{
    ViewData["Title"] = "Contracts";
}
<h1>Contracts</h1>
<p class="muted">Every mission that is still going, with its stops (✓ = picked up or delivered). Click a box to change who has the mission: green ✔ has it, red ✖ does not, gold marks the one who took the contract. The Trip Planner only plans a worker for missions he has. A mission that is not in the game any more can be marked Gone, and brought back with the same button.</p>

@if (Model.Contracts.Count == 0)
{
  <p class="muted">No missions going.</p>
}
else
{
  <table class="wide">
    <thead>
      <tr>
        <th>Contract</th><th>Cargo</th><th>Stops</th>
        @foreach (var n in Model.Members)
        {
          <th>@n.ToUpperInvariant()</th>
        }
        <th></th>
      </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Contracts)
    {
      <tr class="@(c.Gone ? "inactive" : "")">
        <td>@c.Contract</td>
        <td>@c.Cargo</td>
        <td>@c.Stops</td>
        @foreach (var h in c.Holders)
        {
          <td class="center">
            @if (!c.Gone)
            {
              <form method="post" action="/admin/contracts/holder" asp-antiforgery="true">
                <input type="hidden" name="id" value="@c.Id">
                <input type="hidden" name="member" value="@h.Member">
                <input type="hidden" name="has" value="@(h.Has ? "false" : "true")">
                <button type="submit" class="box @(h.Took ? (h.Has ? "took" : "tooknot") : h.Has ? "has" : "hasnot")"
                        title="@(h.Has ? h.Member + " has it: click if he does not" : h.Member + " does not have it: click if he does")">@(h.Has ? "✔" : "✖")@(h.Took ? " took it" : "")</button>
              </form>
            }
          </td>
        }
        <td class="center">
          <form method="post" action="/admin/contracts/gone" asp-antiforgery="true">
            <input type="hidden" name="id" value="@c.Id">
            <button type="submit">@(c.Gone ? "Bring back" : "Gone")</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
}
