@model AdminDebtsModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Debts";
}
<h1>Debts</h1>

<form method="get" action="/admin/debts" class="line">
  <label for="me">Party member</label>
  <select id="me" name="me" asp-items="Model.Names.Select(n => new SelectListItem(n, n, n == Model.Me))" onchange="this.form.submit()"></select>
  <noscript><button type="submit">Show</button></noscript>
</form>

@if (Model.Me.Length > 0)
{
  <h2>Balances of @Model.Me</h2>
  <p class="hint">+ they owe @Model.Me, − @Model.Me owes them. Type over a number to correct it.</p>
  <table class="narrow">
    <thead><tr><th>Party Member</th><th>Balance</th><th>Meaning</th><th></th></tr></thead>
    <tbody>
    @for (var i = 0; i < Model.Balances.Count; i++)
    {
      var b = Model.Balances[i];
      var id = "bal-" + i;
      <tr>
        <td>@b.Other</td>
        <td><input name="balance" value="@b.Balance" class="num" form="@id"></td>
        <td>@b.Meaning</td>
        <td class="right"><form id="@id" method="post" action="/admin/debts/balance" asp-antiforgery="true"><input type="hidden" name="me" value="@Model.Me"><input type="hidden" name="other" value="@b.Other"><button type="submit">Save</button></form></td>
      </tr>
    }
    </tbody>
  </table>

  <h2>Money transfers of @Model.Me</h2>
  @if (Model.Transfers.Count == 0)
  {
    <p class="muted">None.</p>
  }
  else
  {
    <p class="hint">Tick Payment when a transfer pays off a debt.</p>
    <table class="narrow">
      <thead><tr><th>Time</th><th>From</th><th>To</th><th>Amount</th><th>Payment</th><th></th></tr></thead>
      <tbody>
      @for (var i = 0; i < Model.Transfers.Count; i++)
      {
        var x = Model.Transfers[i];
        var id = "tx-" + i;
        <tr>
          <td>@x.Time</td><td>@x.From</td><td>@x.To</td><td class="right">@x.Amount</td>
          <td class="center"><input type="checkbox" name="payment" value="true" checked="@x.Payment" form="@id"></td>
          <td class="right"><form id="@id" method="post" action="/admin/debts/payment" asp-antiforgery="true"><input type="hidden" name="key" value="@x.Key"><input type="hidden" name="me" value="@Model.Me"><button type="submit">Save</button></form></td>
        </tr>
      }
      </tbody>
    </table>
  }
}

<h2>Mission payouts</h2>
@if (Model.Payouts.Count == 0)
{
  <p class="muted">None yet.</p>
}
else
{
  <p class="hint">Every finished mission: its payout and the members who shared it. Type what a mission really paid (a short delivery pays less); empty = the reward of its contract.</p>
  <table class="wide">
    <thead><tr><th>Time</th><th>Mission</th><th>Payout</th><th>Shared Between</th><th>Each</th><th></th></tr></thead>
    <tbody>
    @for (var i = 0; i < Model.Payouts.Count; i++)
    {
      var p = Model.Payouts[i];
      var id = "pay-" + i;
      <tr>
        <td>@p.Time</td><td>@p.Contract</td>
        <td><input name="payout" value="@p.Payout" class="num @(p.Typed ? "typed" : "")" form="@id" title="@(p.Typed ? "typed by you" : "the reward of the contract")"></td>
        <td>@p.Members</td><td class="right">@p.Each</td>
        <td class="right"><form id="@id" method="post" action="/admin/debts/payout" asp-antiforgery="true"><input type="hidden" name="id" value="@p.MissionId"><input type="hidden" name="me" value="@Model.Me"><button type="submit">Save</button></form></td>
      </tr>
    }
    </tbody>
  </table>
}

@if (Model.HasSession)
{
  <h2>Session party</h2>
  <form method="post" action="/admin/debts/party" asp-antiforgery="true" class="card">
    <p class="hint">Everyone who was in the party this session, also someone who carried nothing: the reward of the session is split equally between them.</p>
    @foreach (var (name, isIn) in Model.SessionParty)
    {
      <label class="check"><input type="checkbox" name="names" value="@name" checked="@isIn"> @name</label>
    }
    <input type="hidden" name="me" value="@Model.Me">
    <button type="submit">Save</button>
  </form>
}
