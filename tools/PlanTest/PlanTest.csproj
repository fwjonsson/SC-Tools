<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the trip planner on scenarios from real sessions and prints the plans (no Windows needed). Run it with dotnet run in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HaulingTracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HaulingTracker.Core/HaulingTracker.Core.csproj" />
  </ItemGroup>

</Project>
